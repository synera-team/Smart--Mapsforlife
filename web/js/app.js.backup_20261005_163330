    else if (left <= warnAt) {
      Idle.warned = true;
      toast(`${icon('clock', 20)} <span>${t('idleWarn')} <b>${Math.ceil(left)}</b> ${t('sec')}</span><button class="btn" id="stayBtn">${t('stay')}</button>`, 0, 'idle');
    }
