function registerSW() {
  // Bộ nhớ đệm ngoại tuyến: giao diện, dữ liệu, bản đồ nền → kiosk khởi động nhanh, vẫn chạy khi mạng chập chờn
  if (!('serviceWorker' in navigator) || !(location.protocol === 'https:' || location.hostname === 'localhost' || location.hostname === '127.0.0.1')) return;
  if (S.settings.offline_cache === false) { navigator.serviceWorker.getRegistrations().then(rs => rs.forEach(r => r.unregister())); return; }
  navigator.serviceWorker.register('/sw.js').catch(() => { });
}
async function boot() {
  document.body.classList.toggle('kiosk', KIOSK);
  document.documentElement.lang = LANG;
  const b = S.boot = await api('/api/public/bootstrap' + (DEVICE ? `?device=${encodeURIComponent(DEVICE)}` : ''));
  S.settings = b.settings || {}; S.device = b.device; S.cats = b.categories; S.cats.forEach(c => S.catMap[c.id] = c);
  S.wards = b.wards; S.wards.forEach(w => S.wardMap[w.slug] = w);
  $('#copyright').textContent = S.settings.copyright || 'Bản quyền thuộc về Công ty TNHH Công nghệ và Truyền thông Xanh24';
  $('#idleFoot').textContent = $('#copyright').textContent;
  document.title = S.settings.app_name || 'Xanh24 - Maps for Life';
  const nat0 = nativeLoc(); if (nat0?.lat) S.live = { lat: nat0.lat, lng: nat0.lng, acc: nat0.acc || 0, src: nat0.src || 'android', at: Date.now() };
  S.origin = resolveOrigin();
  if (S.device?.ward_slug) { S.selWard = S.device.ward_slug; S.scope = 'ward'; }
  const fromP = params.get('from');
  if (fromP) { const [la, ln] = fromP.split(',').map(Number); if (la && ln) S.origin = { lat: la, lng: ln, label: t('start'), kind: 'shared' }; }
  updateTitle();
  const [pois, geo, transit] = await Promise.all([api('/api/public/pois'), api('/api/public/wards.geojson'), api('/api/public/transit')]);
  S.pois = pois.items; S.pois.forEach(p => S.poiMap[p.id] = p);
  S.wardGeo = geo; S.transit = transit;
  if (!S.origin) {
    const w = S.selWard && S.wardMap[S.selWard];
    const c = S.settings.default_center || [105.8342, 21.0278];
    S.origin = w?.hq ? { lat: w.hq[1], lng: w.hq[0], label: t('hq') + ' ' + w.short, kind: 'ward' } : { lat: c[1], lng: c[0], label: LANG === 'vi' ? 'Trung tâm Thành phố' : 'City centre', kind: 'default' };
  }
  initUI();
  go({ v: 'home' }, false);

  // Gọi khởi tạo bản đồ sau khi DOM giao diện đã chuẩn bị xong
  initMap();
  startGeo();
  if (params.get('poi')) {
    const id = +params.get('poi'), dir = params.get('dir');
    if (dir && params.get('locate') === '1' && !fromP) {
      pendingAutoRoute = { id, mode: dir };
      openPoi(id);
      toast(`${icon('locate', 18)} ${LANG === 'vi' ? 'Đang lấy vị trí hiện tại để vẽ đường…' : 'Getting your current location for directions…'}`, 0, 'auto-route-locate');
    } else openPoi(id, { dir });
  }
  else if (params.get('pt')) {
    const [la, ln] = params.get('pt').split(',').map(Number);
    if (la && ln) {
      const id = pickAt({ lat: la, lng: ln }, { name: params.get('name') || '' });
      const dir = params.get('dir');
      if (dir && params.get('locate') === '1' && !fromP) {
        pendingAutoRoute = { id, mode: dir };
        toast(`${icon('locate', 18)} ${LANG === 'vi' ? 'Đang lấy vị trí hiện tại để vẽ đường…' : 'Getting your current location for directions…'}`, 0, 'auto-route-locate');
      } else if (dir) startRoute(id, dir);
    }
  }
  else if (params.get('ward')) openWard(params.get('ward'));
  if (KIOSK) initKiosk();
  registerSW();
  track('session_start', { kiosk: KIOSK });
}

