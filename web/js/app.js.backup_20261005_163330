}
function applyIdleText() {
  $('#idleCtaTitle').textContent = t('idleCta'); $('#idleCtaSub').textContent = t('idleSub');
  const qs = [['hanh-chinh', 'building'], ['y-te', 'cross'], ['di-tich', 'temple'], ['transit', 'metro']];
  $('#idleQuick').innerHTML = qs.map(([c, ic]) => `<button data-qcat="${c}">${icon(ic, 22)} ${esc(c === 'transit' ? t('transit') : catName(S.catMap[c]) || c)}</button>`).join('');
