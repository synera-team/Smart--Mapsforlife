    modal(`<div class="mh"><h3>${icon('shield', 22)} Quản trị thiết bị</h3><button class="round" data-close>${icon('close')}</button></div>
      <div class="mb"><div class="pin-dots">${[0, 1, 2, 3].map(i => `<i class="${i < pin.length ? 'on' : ''}"></i>`).join('')}</div>
      <div class="pin-pad">${[1, 2, 3, 4, 5, 6, 7, 8, 9, 'C', 0, '⌫'].map(k => `<button data-k="${k}">${k}</button>`).join('')}</div></div>`);
    $('#modalCard').querySelector('.pin-pad').onclick = async (e) => {
      const k = e.target.closest('button')?.dataset.k; if (k == null) return;
      if (k === 'C') pin = ''; else if (k === '⌫') pin = pin.slice(0, -1); else if (pin.length < 8) pin += k;
      if (pin.length >= 4) {
        try { await api('/api/public/kiosk/unlock', { method: 'POST', body: JSON.stringify({ pin }) }); return deviceMenu(); }
        catch (err) { if (pin.length >= 8 || /PIN|Thử/.test(err.message)) { toast(esc(err.message)); pin = ''; } }
      }
      draw();
    };
  };
  draw();
}
