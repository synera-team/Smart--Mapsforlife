async function loadAds() {
  try { S.ads = (await api('/api/public/ads' + (DEVICE ? `?device=${encodeURIComponent(DEVICE)}` : ''))).items; } catch { S.ads = S.ads || []; }
  if (!S.ads.length) S.ads = [{ id: 0, media_type: 'html', html: `<div class='ad-hero ad-g1'><div class='ad-kicker'>Xanh24</div><h1>Maps for Life</h1><p>${esc(t('idleSub'))}</p></div>`, duration_sec: 10 }];
  const stage = $('#idleStage');
  stage.innerHTML = S.ads.map((a, i) => {
    let inner = '';
    if (a.media_type === 'image') inner = `<img src="${esc(a.media_url)}" alt="">`;
    else if (a.media_type === 'video') inner = `<video src="${esc(a.media_url)}" muted playsinline preload="auto"></video>`;
    else if (a.media_type === 'url') inner = `<iframe src="${esc(a.media_url)}" loading="lazy"></iframe>`;
    else inner = a.html || '';
    return `<div class="idle-slide" data-i="${i}">${inner}</div>`;
  }).join('');
  $('#idleDots').innerHTML = S.ads.length > 1 ? S.ads.map(() => '<i></i>').join('') : '';
  if (Idle.active) playSlide(0);
}
let slideT, slideIdx = 0;
function playSlide(i) {
  clearTimeout(slideT);
  const slides = $$('.idle-slide'); if (!slides.length) return;
  slideIdx = (i + slides.length) % slides.length;
  slides.forEach((s, k) => { s.classList.toggle('on', k === slideIdx); const v = s.querySelector('video'); if (v && k !== slideIdx) v.pause(); });
  $$('#idleDots i').forEach((d, k) => d.classList.toggle('on', k === slideIdx));
  const ad = S.ads[slideIdx]; const v = slides[slideIdx].querySelector('video');
  if (v) { v.currentTime = 0; v.play().catch(() => { }); v.onended = () => playSlide(slideIdx + 1); slideT = setTimeout(() => playSlide(slideIdx + 1), Math.max(ad.duration_sec || 30, 5) * 1000 + 60000); }
  else slideT = setTimeout(() => playSlide(slideIdx + 1), Math.max(ad.duration_sec || 10, 3) * 1000);
  if (ad?.id) track('ad_impression', { ad: ad.id });
}
function enterIdle(reset = true) {
  if (S.dataPending && reset) { flushEvents(); location.reload(); return; }
  if (reset) resetApp();
  hideToast('idle'); Idle.active = true; Idle.warned = false;
  flushEvents();
  $('#idle').hidden = false; playSlide(0);
}
function exitIdle() {
  Idle.active = false; Idle.last = Date.now(); clearTimeout(slideT);
  $$('.idle-slide video').forEach(v => v.pause());
  $('#idle').hidden = true;
  S.session = Math.random().toString(36).slice(2);
  track('session_start', { kiosk: true });
  map?.resize();
}
