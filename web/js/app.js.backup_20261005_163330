function tileOption(id) {
  const o = S.settings.tiles?.options || [];
  return o.find(x => x.id === id) || o[0] || { id: 'ofm', style: 'https://tiles.openfreemap.org/styles/liberty' };
}
function styleFor(id) {
  const opt = tileOption(id);
  if (opt.style) return opt.style; // bản đồ vector (VD: OpenFreeMap) — URL style JSON
  return {
    version: 8, sources: { base: { type: 'raster', tiles: opt.tiles, tileSize: opt.tileSize || 256, attribution: opt.attribution, maxzoom: opt.maxzoom || 19 } },
    layers: [{ id: 'bg', type: 'background', paint: { 'background-color': '#EEF2F6' } }, { id: 'base', type: 'raster', source: 'base', paint: { 'raster-fade-duration': 150 } }]
  };
