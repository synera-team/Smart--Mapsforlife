const Idle = { last: Date.now(), active: false, warned: false };
function initKiosk() {
  document.addEventListener('contextmenu', (e) => e.preventDefault());
  const timeout = S.device?.idle_timeout || S.settings.idle_timeout || 40;
  const warnAt = S.settings.idle_warning || 6;
  const poke = () => { Idle.last = Date.now(); if (Idle.warned) { Idle.warned = false; hideToast('idle'); } };
