const norm = (s) => String(s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[đĐ]/g, 'd').toLowerCase();
function hav(a, b) { const R = 6371000, r = Math.PI / 180, dl = (b.lat - a.lat) * r, dn = (b.lng - a.lng) * r; const x = Math.sin(dl / 2) ** 2 + Math.cos(a.lat * r) * Math.cos(b.lat * r) * Math.sin(dn / 2) ** 2; return 2 * R * Math.asin(Math.sqrt(x)); }
const fmtDist = (m) => m < 1000 ? `${Math.round(m / 10) * 10} m` : `${(m / 1000).toFixed(m < 10000 ? 1 : 0).replace('.', LANG === 'vi' ? ',' : '.')} km`;
function fmtDur(s) { const m = Math.max(1, Math.round(s / 60)); if (m < 60) return [m, t('min')]; const h = Math.floor(m / 60); return [`${h} ${t('hour')} ${m % 60}`, t('min')]; }
const api = async (url, opt = {}) => { const r = await fetch(url, { ...opt, headers: { 'Content-Type': 'application/json', ...(opt.headers || {}) } }); if (!r.ok) throw new Error((await r.json().catch(() => ({}))).error || r.statusText); return r.json(); };
const hl = (text, q) => {
  text = String(text || ''); if (!q) return esc(text);
  const n = norm(text); const marks = new Array(text.length).fill(false);
  norm(q).split(/\s+/).filter(Boolean).forEach(k => { let i = n.indexOf(k); while (i >= 0) { for (let j = i; j < i + k.length; j++) marks[j] = true; i = n.indexOf(k, i + k.length); } });
  let out = '', on = false;
  for (let i = 0; i < text.length; i++) { if (marks[i] !== on) { out += marks[i] ? '<mark>' : '</mark>'; on = marks[i]; } out += esc(text[i]); }
  return out + (on ? '</mark>' : '');
};
